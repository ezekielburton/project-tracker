[Unit]
Description=OVP Heartbeat
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=helixadmin
WorkingDirectory=/home/helixadmin/project-tracker
ExecStart=/home/helixadmin/project-tracker/venv/bin/python -m app.modules.system.collectors.heartbeat
SyslogIdentifier=ovp-heartbeat
TimeoutStartSec=50
