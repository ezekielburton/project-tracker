[Unit]
Description=OVP VACUUM ANALYZE
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=helixadmin
WorkingDirectory=/home/helixadmin/project-tracker
ExecStart=/home/helixadmin/project-tracker/venv/bin/python -m app.modules.system.jobs.vacuum
SyslogIdentifier=ovp-vacuum-analyze
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
