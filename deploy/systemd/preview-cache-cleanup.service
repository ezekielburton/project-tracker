[Unit]
Description=OVP Preview-cache cleanup
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=helixadmin
WorkingDirectory=/home/helixadmin/project-tracker
ExecStart=/home/helixadmin/project-tracker/venv/bin/python preview_cache_cleanup.py
SyslogIdentifier=ovp-preview-cache-cleanup
