[Unit]
Description=OVP Nightly backup
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=helixadmin
WorkingDirectory=/home/helixadmin/project-tracker
ExecStart=/home/helixadmin/project-tracker/venv/bin/python -m app.modules.system.jobs.backup
SyslogIdentifier=ovp-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
