[Unit]
Description=OVP Notifications purge (90 days)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=helixadmin
WorkingDirectory=/home/helixadmin/project-tracker
ExecStart=/home/helixadmin/project-tracker/venv/bin/python -m app.modules.system.jobs.purge_notifications
SyslogIdentifier=ovp-notifications-purge
