[Unit]
Description=OVP Snapshot collector
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=helixadmin
WorkingDirectory=/home/helixadmin/project-tracker
ExecStart=/home/helixadmin/project-tracker/venv/bin/python -m app.modules.system.collectors.snapshot
SyslogIdentifier=ovp-snapshot
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
