"""
Throwaway verification script for Chunk 6b (Submit for Review / Edit /
Flag Internal Revision routes).
Run from the repo root: python _test_submission_review.py
Delete this file after running.

Structural note: client.post() calls are made with NO app context already
pushed by this script, so Flask's own request dispatch pushes a fresh one
(and a fresh flask.g) for every single request. flask_login caches the
loaded user on g for the lifetime of the app context, not the request —
wrapping everything in one outer `with app.app_context()` (as an earlier
version of this script did) causes every request after the first to reuse
the first request's cached user regardless of the session cookie. DB
verification between requests gets its own short `with app.app_context()`
block instead.
"""
import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from app import create_app, db
from app.models import (User, Project, Deliverable, ProjectSubmission,
                         ProjectSubmissionFile, ProjectSubmissionEvent,
                         ProjectSubmissionDeliverable, DeliverableStatusLog)
from app.submission_cache import clear_submission_cache

app = create_app()

PROJECT_ID = 39  # change to a real Standard Brief project id, with a CS lead + >=1 deliverable

with app.app_context():
    project = db.session.get(Project, PROJECT_ID)
    assert project is not None, f"No project with id {PROJECT_ID}"
    assert project.brief_type == 'standard', "This script assumes a Standard Brief project"
    assert project.cs_lead is not None, "This script assumes the project has a CS lead"

    deliverable = Deliverable.query.filter_by(project_id=PROJECT_ID, project_customer_id=None).first()
    assert deliverable is not None, "This script assumes the project has at least one deliverable"

    designer = User.query.filter_by(role='designer').first() or User.query.filter(User.role != 'cs').first()
    cs_user = project.cs_lead
    print(f"Designer: {designer.name} (id={designer.id})")
    print(f"CS Lead:  {cs_user.name} (id={cs_user.id}, role={cs_user.role})")
    print(f"Deliverable: {deliverable.name} (id={deliverable.id})")

    stale = ProjectSubmission.query.filter_by(
        project_id=PROJECT_ID, phase='concept_kv', posm_country=None,
        posm_customer_id=None, is_active=True,
    ).filter(ProjectSubmission.workflow_status.isnot(None)).first()
    if stale:
        print(f"Clearing stale submission {stale.id} from a previous test run...")
        clear_submission_cache(PROJECT_ID, stale.id)
        ProjectSubmissionEvent.query.filter_by(submission_id=stale.id).delete()
        ProjectSubmissionDeliverable.query.filter_by(submission_id=stale.id).delete()
        ProjectSubmissionFile.query.filter_by(submission_id=stale.id).delete()
        db.session.delete(stale)
        db.session.commit()

    # Capture plain IDs — we're about to leave this app context, and ORM
    # objects don't safely carry across a context/session boundary.
    deliverable_id = deliverable.id
    designer_id = designer.id
    cs_user_id = cs_user.id

client = app.test_client()

def login_as(user_id):
    with client.session_transaction() as sess:
        sess['_user_id'] = str(user_id)
        sess['_fresh'] = True

# 1) Upload a file to a fresh draft, as the designer
login_as(designer_id)
r1 = client.post(
    f'/projects/{PROJECT_ID}/overlay/submissions/draft/upload',
    data={'scope': 'ckv', 'file': (open(__file__, 'rb'), 'deck-v1.pdf')},
    content_type='multipart/form-data',
)
print("Upload:", r1.status_code, r1.get_json())
assert r1.status_code == 200

with app.app_context():
    draft = ProjectSubmission.query.filter_by(
        project_id=PROJECT_ID, phase='concept_kv', posm_country=None,
        posm_customer_id=None, is_active=True, workflow_status='draft',
    ).first()
    assert draft is not None
    draft_id = draft.id

# 2) Permission check: CS cannot submit for review
login_as(cs_user_id)
r_perm = client.post(
    f'/projects/{PROJECT_ID}/overlay/submissions/draft/submit-for-review',
    json={'scope': 'ckv', 'note': 'nope', 'deliverable_ids': [deliverable_id]},
)
print("CS attempts submit-for-review (expect 403):", r_perm.status_code, r_perm.get_json())
assert r_perm.status_code == 403

# 3) Submit for review with a note + deliverable, as the designer
login_as(designer_id)
r2 = client.post(
    f'/projects/{PROJECT_ID}/overlay/submissions/draft/submit-for-review',
    json={'scope': 'ckv', 'note': 'First pass, please check the logo placement',
          'deliverable_ids': [deliverable_id]},
)
print("Submit for review:", r2.status_code, r2.get_json())
assert r2.status_code == 200

with app.app_context():
    draft = db.session.get(ProjectSubmission, draft_id)
    print(f"workflow_status after submit: {draft.workflow_status}")
    assert draft.workflow_status == 'internal_review'
    assert draft.is_being_edited is False

    events = ProjectSubmissionEvent.query.filter_by(submission_id=draft_id).order_by(ProjectSubmissionEvent.created_at).all()
    print(f"Events after submit: {[(e.event_type, e.message) for e in events]}")
    assert len(events) == 1
    assert events[0].event_type == 'submitted_for_review'
    assert events[0].message == 'First pass, please check the logo placement'

    log = DeliverableStatusLog.query.filter_by(deliverable_id=deliverable_id, ended_at=None).first()
    print(f"Deliverable status after submit: {log.status if log else None}")
    assert log and log.status == 'internal_review'

# 4) Permission check: designer cannot flag internal revision
login_as(designer_id)
r_perm2 = client.post(
    f'/projects/{PROJECT_ID}/overlay/submissions/draft/flag-internal-revision',
    json={'scope': 'ckv', 'message': 'nope'},
)
print("Designer attempts flag-internal-revision (expect 403):", r_perm2.status_code, r_perm2.get_json())
assert r_perm2.status_code == 403

# 5) Designer edits (reason required)
login_as(designer_id)
r3 = client.post(
    f'/projects/{PROJECT_ID}/overlay/submissions/draft/edit',
    json={'scope': 'ckv', 'reason': ''},
)
print("Edit with no reason (expect 400):", r3.status_code, r3.get_json())
assert r3.status_code == 400

r4 = client.post(
    f'/projects/{PROJECT_ID}/overlay/submissions/draft/edit',
    json={'scope': 'ckv', 'reason': 'Noticed a typo, fixing it'},
)
print("Edit with reason:", r4.status_code, r4.get_json())
assert r4.status_code == 200

with app.app_context():
    draft = db.session.get(ProjectSubmission, draft_id)
    print(f"is_being_edited: {draft.is_being_edited}, editing_started_at: {draft.editing_started_at}")
    assert draft.is_being_edited is True
    assert draft.editing_started_at is not None
    assert draft.workflow_status == 'internal_review'

# 6) Upload a second file while being edited — should land on the SAME draft
r5 = client.post(
    f'/projects/{PROJECT_ID}/overlay/submissions/draft/upload',
    data={'scope': 'ckv', 'file': (open(__file__, 'rb'), 'deck-v2-fix.pdf')},
    content_type='multipart/form-data',
)
print("Upload during edit:", r5.status_code, r5.get_json())
assert r5.status_code == 200

with app.app_context():
    cache_files = ProjectSubmissionFile.query.filter_by(submission_id=draft_id, storage_location='cache').all()
    print(f"Cached files on original draft: {[f.original_filename for f in cache_files]}")
    assert len(cache_files) == 2, "Upload during edit should land on the same draft, not spawn a new one"

# 7) Re-submit for review (closes the edit loop)
r6 = client.post(
    f'/projects/{PROJECT_ID}/overlay/submissions/draft/submit-for-review',
    json={'scope': 'ckv', 'deliverable_ids': [deliverable_id]},
)
print("Re-submit for review:", r6.status_code, r6.get_json())
assert r6.status_code == 200

with app.app_context():
    draft = db.session.get(ProjectSubmission, draft_id)
    print(f"workflow_status after resubmit: {draft.workflow_status}, is_being_edited: {draft.is_being_edited}")
    assert draft.workflow_status == 'internal_review'
    assert draft.is_being_edited is False

    events = ProjectSubmissionEvent.query.filter_by(submission_id=draft_id).order_by(ProjectSubmissionEvent.created_at).all()
    print(f"Events after resubmit: {[e.event_type for e in events]}")
    assert [e.event_type for e in events] == ['submitted_for_review', 'edited', 'submitted_for_review']

# 8) CS flags an internal revision
login_as(cs_user_id)
r7 = client.post(
    f'/projects/{PROJECT_ID}/overlay/submissions/draft/flag-internal-revision',
    json={'scope': 'ckv', 'message': '<p>Please make the logo <b>bigger</b>.</p>'},
)
print("Flag internal revision:", r7.status_code, r7.get_json())
assert r7.status_code == 200

with app.app_context():
    draft = db.session.get(ProjectSubmission, draft_id)
    print(f"workflow_status after flag: {draft.workflow_status}")
    assert draft.workflow_status == 'internal_revision'
    assert draft.is_being_edited is False

    log = DeliverableStatusLog.query.filter_by(deliverable_id=deliverable_id, ended_at=None).first()
    print(f"Deliverable status after flag: {log.status if log else None}")
    assert log and log.status == 'internal_revision'

    events = ProjectSubmissionEvent.query.filter_by(submission_id=draft_id).order_by(ProjectSubmissionEvent.created_at).all()
    print(f"Events after flag: {[(e.event_type, e.message) for e in events]}")
    assert events[-1].event_type == 'internal_revision'
    assert events[-1].message == '<p>Please make the logo <b>bigger</b>.</p>'

print("\nAll checks passed.")